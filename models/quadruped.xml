<!--
  The erg four-legged robot (design record docs/design/2026-11-24-robot-and-comparison.md).

  Frame: x forward, y left, z up. Units: metres, kilograms, seconds, radians.
  Legs: FL, FR, HL, HR (front/hind, left/right). Joints per leg: hip_abd (about x), hip_flex (about y), knee (about y).

  Kept convertible to URDF (for Isaac Lab later): only hinge joints and one free joint at the root, an explicit
  <inertial> in every body, geoms are boxes, capsules, spheres or a plane, no tendons, no equality constraints.
  tests/test_robot_model.py checks these rules.

  Servo: Feetech STS3215 at 7.4 V. Datasheet values: stall torque 19.5 kg*cm = 1.91 N*m, no-load speed
  0.19 s per 60 degrees = 5.51 rad/s. These set:
    - forcerange = +-1.91 N*m on every actuator;
    - joint damping = stall torque / no-load speed = 0.3466 N*m*s/rad, the straight-line torque-speed curve of a
      DC motor (its back-EMF), so that no joint turns faster than the servo can.
  Estimates, NOT measured, to be replaced by identification on the real servo (as with the BAM tool):
    armature, frictionloss, position gain kp.

  Legs follow the printed frame of erg/frame.py (Issue #25; design record docs/design/2026-11-25-first-leg-frame.md):
  the hip flexion shaft is 61.2 mm below the abduction shaft, thigh and shank are 90 mm, and the masses, centres of
  mass and inertias of the hip, thigh and shank bodies are computed from the printed parts (PLA, 100 % infill) and
  the servos they carry (tests/test_frame.py checks this). The knee range stops at -2.5 rad, where the folded shank would touch
  the thigh. The torso (0.75 kg: four abduction servos, microcontrollers, battery, torso frame) is still an estimate.
  Total 1.61 kg, inside the 1.2-2 kg range of the design record. Replace with weighed values after building.
  Shown for the left legs; the right legs are their mirror images.

  Collisions: feet, shanks and the torso touch the floor; parts of the robot do not touch each other (the frame
  allows every combination of joint angles except a fully folded knee with the hip flexed far forward, which is not
  yet excluded here).

  Sensors, per leg (what that leg's microcontroller reads): joint positions, speeds and loads of its three servos;
  an IMU (accelerometer and gyroscope) on the torso where the leg meets the body; a touch sensor at the foot, which
  stands for the foot's microswitch.
-->
<mujoco model="erg_quadruped">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <joint damping="0.3466" armature="0.01" frictionloss="0.05"/>
    <position kp="10" forcerange="-1.91 1.91"/>
    <geom contype="0" conaffinity="0" friction="0.8 0.02 0.0001"/>
    <default class="abd">
      <joint axis="1 0 0" range="-0.5 0.5"/>
      <position ctrlrange="-0.5 0.5"/>
    </default>
    <default class="flex">
      <joint axis="0 1 0" range="-1.6 1.6"/>
      <position ctrlrange="-1.6 1.6"/>
    </default>
    <default class="knee">
      <joint axis="0 1 0" range="-2.5 -0.2"/>
      <position ctrlrange="-2.5 -0.2"/>
    </default>
    <default class="touch">
      <geom contype="1" conaffinity="0"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" contype="0" conaffinity="1"/>

    <body name="torso" pos="0 0 0.23">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.75" diaginertia="0.001056 0.003181 0.003925"/>
      <geom name="torso" class="touch" type="box" size="0.11 0.06 0.025"/>
      <site name="FL_imu" pos="0.09 0.05 0"/>
      <site name="FR_imu" pos="0.09 -0.05 0"/>
      <site name="HL_imu" pos="-0.09 0.05 0"/>
      <site name="HR_imu" pos="-0.09 -0.05 0"/>

      <!-- Front left -->
      <body name="FL_hip" pos="0.09 0.05 0">
        <inertial pos="0 -0.0003 -0.0379" mass="0.08212" fullinertia="4.186e-5 4.407e-5 2.016e-5 0 0 -1.975e-7"/>
        <joint name="FL_hip_abd" class="abd"/>
        <geom type="box" pos="0 0 -0.0487" size="0.0124 0.0159 0.0227"/>
        <body name="FL_thigh" pos="0 0 -0.0612">
          <inertial pos="0 -0.0003 -0.0601" mass="0.08737" fullinertia="9.469e-5 7.708e-5 2.648e-5 0 0 -3.738e-7"/>
          <joint name="FL_hip_flex" class="flex"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.09" size="0.012"/>
          <body name="FL_shank" pos="0 0 -0.09">
            <inertial pos="0 0 -0.0609" mass="0.04538" diaginertia="6.041e-5 4.751e-5 1.594e-5"/>
            <joint name="FL_knee" class="knee"/>
            <geom class="touch" type="capsule" fromto="0 0 0 0 0 -0.078" size="0.008"/>
            <geom name="FL_foot" class="touch" type="sphere" pos="0 0 -0.09" size="0.012"/>
            <site name="FL_foot" pos="0 0 -0.09" size="0.014"/>
          </body>
        </body>
      </body>

      <!-- Front right -->
      <body name="FR_hip" pos="0.09 -0.05 0">
        <inertial pos="0 0.0003 -0.0379" mass="0.08212" fullinertia="4.186e-5 4.407e-5 2.016e-5 0 0 1.975e-7"/>
        <joint name="FR_hip_abd" class="abd"/>
        <geom type="box" pos="0 0 -0.0487" size="0.0124 0.0159 0.0227"/>
        <body name="FR_thigh" pos="0 0 -0.0612">
          <inertial pos="0 0.0003 -0.0601" mass="0.08737" fullinertia="9.469e-5 7.708e-5 2.648e-5 0 0 3.738e-7"/>
          <joint name="FR_hip_flex" class="flex"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.09" size="0.012"/>
          <body name="FR_shank" pos="0 0 -0.09">
            <inertial pos="0 0 -0.0609" mass="0.04538" diaginertia="6.041e-5 4.751e-5 1.594e-5"/>
            <joint name="FR_knee" class="knee"/>
            <geom class="touch" type="capsule" fromto="0 0 0 0 0 -0.078" size="0.008"/>
            <geom name="FR_foot" class="touch" type="sphere" pos="0 0 -0.09" size="0.012"/>
            <site name="FR_foot" pos="0 0 -0.09" size="0.014"/>
          </body>
        </body>
      </body>

      <!-- Hind left -->
      <body name="HL_hip" pos="-0.09 0.05 0">
        <inertial pos="0 -0.0003 -0.0379" mass="0.08212" fullinertia="4.186e-5 4.407e-5 2.016e-5 0 0 -1.975e-7"/>
        <joint name="HL_hip_abd" class="abd"/>
        <geom type="box" pos="0 0 -0.0487" size="0.0124 0.0159 0.0227"/>
        <body name="HL_thigh" pos="0 0 -0.0612">
          <inertial pos="0 -0.0003 -0.0601" mass="0.08737" fullinertia="9.469e-5 7.708e-5 2.648e-5 0 0 -3.738e-7"/>
          <joint name="HL_hip_flex" class="flex"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.09" size="0.012"/>
          <body name="HL_shank" pos="0 0 -0.09">
            <inertial pos="0 0 -0.0609" mass="0.04538" diaginertia="6.041e-5 4.751e-5 1.594e-5"/>
            <joint name="HL_knee" class="knee"/>
            <geom class="touch" type="capsule" fromto="0 0 0 0 0 -0.078" size="0.008"/>
            <geom name="HL_foot" class="touch" type="sphere" pos="0 0 -0.09" size="0.012"/>
            <site name="HL_foot" pos="0 0 -0.09" size="0.014"/>
          </body>
        </body>
      </body>

      <!-- Hind right -->
      <body name="HR_hip" pos="-0.09 -0.05 0">
        <inertial pos="0 0.0003 -0.0379" mass="0.08212" fullinertia="4.186e-5 4.407e-5 2.016e-5 0 0 1.975e-7"/>
        <joint name="HR_hip_abd" class="abd"/>
        <geom type="box" pos="0 0 -0.0487" size="0.0124 0.0159 0.0227"/>
        <body name="HR_thigh" pos="0 0 -0.0612">
          <inertial pos="0 0.0003 -0.0601" mass="0.08737" fullinertia="9.469e-5 7.708e-5 2.648e-5 0 0 3.738e-7"/>
          <joint name="HR_hip_flex" class="flex"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.09" size="0.012"/>
          <body name="HR_shank" pos="0 0 -0.09">
            <inertial pos="0 0 -0.0609" mass="0.04538" diaginertia="6.041e-5 4.751e-5 1.594e-5"/>
            <joint name="HR_knee" class="knee"/>
            <geom class="touch" type="capsule" fromto="0 0 0 0 0 -0.078" size="0.008"/>
            <geom name="HR_foot" class="touch" type="sphere" pos="0 0 -0.09" size="0.012"/>
            <site name="HR_foot" pos="0 0 -0.09" size="0.014"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="FL_hip_abd" joint="FL_hip_abd" class="abd"/>
    <position name="FL_hip_flex" joint="FL_hip_flex" class="flex"/>
    <position name="FL_knee" joint="FL_knee" class="knee"/>
    <position name="FR_hip_abd" joint="FR_hip_abd" class="abd"/>
    <position name="FR_hip_flex" joint="FR_hip_flex" class="flex"/>
    <position name="FR_knee" joint="FR_knee" class="knee"/>
    <position name="HL_hip_abd" joint="HL_hip_abd" class="abd"/>
    <position name="HL_hip_flex" joint="HL_hip_flex" class="flex"/>
    <position name="HL_knee" joint="HL_knee" class="knee"/>
    <position name="HR_hip_abd" joint="HR_hip_abd" class="abd"/>
    <position name="HR_hip_flex" joint="HR_hip_flex" class="flex"/>
    <position name="HR_knee" joint="HR_knee" class="knee"/>
  </actuator>
  <sensor>
    <!-- FL: what this leg's microcontroller reads -->
    <jointpos name="FL_hip_abd_pos" joint="FL_hip_abd"/>
    <jointpos name="FL_hip_flex_pos" joint="FL_hip_flex"/>
    <jointpos name="FL_knee_pos" joint="FL_knee"/>
    <jointvel name="FL_hip_abd_vel" joint="FL_hip_abd"/>
    <jointvel name="FL_hip_flex_vel" joint="FL_hip_flex"/>
    <jointvel name="FL_knee_vel" joint="FL_knee"/>
    <actuatorfrc name="FL_hip_abd_load" actuator="FL_hip_abd"/>
    <actuatorfrc name="FL_hip_flex_load" actuator="FL_hip_flex"/>
    <actuatorfrc name="FL_knee_load" actuator="FL_knee"/>
    <accelerometer name="FL_acc" site="FL_imu"/>
    <gyro name="FL_gyro" site="FL_imu"/>
    <touch name="FL_touch" site="FL_foot"/>
    <!-- FR: what this leg's microcontroller reads -->
    <jointpos name="FR_hip_abd_pos" joint="FR_hip_abd"/>
    <jointpos name="FR_hip_flex_pos" joint="FR_hip_flex"/>
    <jointpos name="FR_knee_pos" joint="FR_knee"/>
    <jointvel name="FR_hip_abd_vel" joint="FR_hip_abd"/>
    <jointvel name="FR_hip_flex_vel" joint="FR_hip_flex"/>
    <jointvel name="FR_knee_vel" joint="FR_knee"/>
    <actuatorfrc name="FR_hip_abd_load" actuator="FR_hip_abd"/>
    <actuatorfrc name="FR_hip_flex_load" actuator="FR_hip_flex"/>
    <actuatorfrc name="FR_knee_load" actuator="FR_knee"/>
    <accelerometer name="FR_acc" site="FR_imu"/>
    <gyro name="FR_gyro" site="FR_imu"/>
    <touch name="FR_touch" site="FR_foot"/>
    <!-- HL: what this leg's microcontroller reads -->
    <jointpos name="HL_hip_abd_pos" joint="HL_hip_abd"/>
    <jointpos name="HL_hip_flex_pos" joint="HL_hip_flex"/>
    <jointpos name="HL_knee_pos" joint="HL_knee"/>
    <jointvel name="HL_hip_abd_vel" joint="HL_hip_abd"/>
    <jointvel name="HL_hip_flex_vel" joint="HL_hip_flex"/>
    <jointvel name="HL_knee_vel" joint="HL_knee"/>
    <actuatorfrc name="HL_hip_abd_load" actuator="HL_hip_abd"/>
    <actuatorfrc name="HL_hip_flex_load" actuator="HL_hip_flex"/>
    <actuatorfrc name="HL_knee_load" actuator="HL_knee"/>
    <accelerometer name="HL_acc" site="HL_imu"/>
    <gyro name="HL_gyro" site="HL_imu"/>
    <touch name="HL_touch" site="HL_foot"/>
    <!-- HR: what this leg's microcontroller reads -->
    <jointpos name="HR_hip_abd_pos" joint="HR_hip_abd"/>
    <jointpos name="HR_hip_flex_pos" joint="HR_hip_flex"/>
    <jointpos name="HR_knee_pos" joint="HR_knee"/>
    <jointvel name="HR_hip_abd_vel" joint="HR_hip_abd"/>
    <jointvel name="HR_hip_flex_vel" joint="HR_hip_flex"/>
    <jointvel name="HR_knee_vel" joint="HR_knee"/>
    <actuatorfrc name="HR_hip_abd_load" actuator="HR_hip_abd"/>
    <actuatorfrc name="HR_hip_flex_load" actuator="HR_hip_flex"/>
    <actuatorfrc name="HR_knee_load" actuator="HR_knee"/>
    <accelerometer name="HR_acc" site="HR_imu"/>
    <gyro name="HR_gyro" site="HR_imu"/>
    <touch name="HR_touch" site="HR_foot"/>
  </sensor>
</mujoco>
