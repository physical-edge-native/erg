CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# XIAO ESP32-S3: 8 MB flash, 8 MB octal PSRAM; large allocations (WebAssembly memory) go to PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Console on the USB port of the XIAO, so GPIO43/44 (D6/D7) are free for the servo bus.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# WAMR: the interpreter, as in Dyne's ESP32 firmware.
CONFIG_WAMR_ENABLE_INTERP=y
